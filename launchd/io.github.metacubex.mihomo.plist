<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.metacubex.mihomo</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/mihomo</string>
    <string>-d</string>
    <string>/opt/homebrew/etc/mihomo</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/opt/homebrew/var/log/mihomo.log</string>
  <key>StandardErrorPath</key>
  <string>/opt/homebrew/var/log/mihomo.log</string>
  <key>UserName</key>
  <string>root</string>
  <key>WorkingDirectory</key>
  <string>/opt/homebrew/etc/mihomo</string>
  <key>ThrottleInterval</key>
  <integer>5</integer>
</dict>
</plist>
